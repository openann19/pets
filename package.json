{
  "name": "pawfectmatch-premium",
  "version": "1.0.0",
  "description": "PawfectMatch Premium - AI-powered pet matching platform",
  "private": true,
  "scripts": {
    "dev": "./dev.sh",
    "build": "turbo build",
    "test": "turbo test",
    "test:watch": "turbo test:watch",
    "test:coverage": "turbo test:coverage",
    "test:unit": "turbo test --filter=!e2e",
    "test:integration": "turbo test --filter=server -- tests/integration/",
    "test:contract": "turbo test --filter=server -- tests/contracts/",
    "test:e2e": "turbo test:e2e",
    "test:e2e:cypress": "cd apps/web && npm run cypress:headless",
    "test:e2e:playwright": "cd apps/web && npm run playwright",
    "test:visual": "cd apps/web && npm run playwright -- tests/visual/",
    "test:load": "k6 run tests/load/load-test.js",
    "test:stress": "k6 run tests/load/stress-test.js",
    "test:chaos": "cd apps/web && npm run playwright -- tests/chaos/",
    "test:security": "npm audit --audit-level=high",
    "test:performance": "cd apps/web && npm run lighthouse-ci",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:contract && npm run test:e2e && npm run test:visual && npm run test:load && npm run test:chaos && npm run test:security && npm run test:performance",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "clean": "turbo clean && rm -rf node_modules",
    "deploy": "./scripts/deploy-production.sh",
    "health-check": "./scripts/health-check.sh",
    "quality-gate": "sonar-scanner -Dsonar.projectKey=pawfectmatch-premium -Dsonar.organization=pawfectmatch",
    "setup:test": "npm install && npm run build && npm run test:coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky install"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@pact-foundation/pact": "^13.0.0",
    "@percy/playwright": "^1.0.0",
    "@playwright/test": "^1.40.0",
    "@react-native/metro-config": "^0.73.0",
    "@types/luxon": "^3.7.1",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^8.0.3",
    "k6": "^0.0.0",
    "lighthouse-ci": "^1.13.1",
    "lint-staged": "^15.2.2",
    "prettier": "^3.6.2",
    "sonar-scanner": "^3.1.0",
    "turbo": "^1.10.0",
    "vitest": "^3.2.4"
  },
  "packageManager": "npm@10.0.0",
  "dependencies": {
    "critters": "^0.0.25",
    "firebase": "^12.3.0",
    "lucide-react": "^0.544.0"
  }
}
