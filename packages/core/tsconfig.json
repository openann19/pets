{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "verbatimModuleSyntax": false,
    "lib": ["ES2023", "DOM"],
    "moduleResolution": "bundler"
  },
  "include": [
    "src/**/*",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/__tests__/**/*",
    "src/__mocks__/**/*",
    "src/setupTests.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
