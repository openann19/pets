{
  "extends": "./tsconfig.json",
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/__tests__/**/*.ts",
    "src/**/__tests__/**/*.tsx",
    "src/__mocks__/**/*.ts",
    "src/setupTests.ts"
  ],
  "exclude": [],
  "compilerOptions": {
    "noEmit": true,
    "types": ["jest", "node"]
  }
}