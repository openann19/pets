# Test Environment Configuration
# These are SAFE test-only values for CI/local testing

NODE_ENV=test
PORT=3001
API_URL=http://localhost:3001

# Test Database (in-memory or isolated test DB)
MONGODB_URI=mongodb://localhost:27017/pawfectmatch_test
MONGODB_TEST_URI=mongodb://localhost:27017/pawfectmatch_test

# Test JWT Secrets (32+ chars, test-only, not for production)
JWT_SECRET=test-jwt-secret-key-minimum-32-characters-for-testing-only-do-not-use-in-production
JWT_REFRESH_SECRET=test-refresh-secret-key-minimum-32-characters-for-testing-only-do-not-use-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Test Cloudinary (mock values, real uploads should be mocked in tests)
CLOUDINARY_CLOUD_NAME=test-cloud
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=test-api-secret-for-testing-only

# Test Stripe (use Stripe test mode keys or mock)
STRIPE_SECRET_KEY=sk_test_51MockTestKeyForJestTestsOnly123456789012345678901234567890123456789012345678901234567890
STRIPE_PUBLISHABLE_KEY=pk_test_MockPublishableKeyForTests
STRIPE_WEBHOOK_SECRET=whsec_test_webhook_secret_for_testing_only_minimum_32_characters_required

# Test SendGrid (mock in tests, this prevents actual emails)
SENDGRID_API_KEY=SG.test_sendgrid_api_key_for_testing_only
EMAIL_FROM=test@pawfectmatch.com

# Socket.io CORS for tests
SOCKET_CORS_ORIGIN=http://localhost:3000,http://localhost:19006

# Admin/Moderation
ADMIN_EMAIL=admin@test.com

# Optional: Disable external API calls in tests
DISABLE_EXTERNAL_APIS=true
