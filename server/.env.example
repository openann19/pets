# Server Configuration
NODE_ENV=development
PORT=5001
CLIENT_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/pawfectmatch

# JWT
JWT_SECRET=super-secret-jwt-key-for-development-only-change-in-production-12345
JWT_REFRESH_SECRET=super-secret-refresh-key-for-development-only-change-in-production-67890
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Cloudinary (Image Upload) - Optional
CLOUDINARY_CLOUD_NAME=demo
CLOUDINARY_API_KEY=demo
CLOUDINARY_API_SECRET=demo

# Redis (Optional - for caching)
# REDIS_URL=redis://localhost:6379

# Email (Nodemailer) - Optional
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=demo@example.com
EMAIL_PASS=demo

# Stripe (Premium Features) - Optional
STRIPE_SECRET_KEY=sk_test_demo
STRIPE_WEBHOOK_SECRET=whsec_demo

# AI Service - Optional
AI_SERVICE_URL=http://localhost:8000

# External APIs - Optional
GOOGLE_MAPS_API_KEY=demo

# Sentry - Optional (disabled for development)
# SENTRY_DSN=

# DeepSeek AI Configuration - SECURE THIS IN PRODUCTION
DEEPSEEK_API_KEY=sk-demo-key-replace-with-real-key-in-production
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
