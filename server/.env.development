# Development Environment Variables
NODE_ENV=development
PORT=5001

# JWT Secrets (32+ characters for development)
JWT_SECRET=dev_super_secret_jwt_key_123456789012345678901234567890
JWT_REFRESH_SECRET=dev_refresh_secret_key_987654321098765432109876543210

# Database
MONGODB_URI=mongodb://localhost:27017/pawfectmatch

# Client URL
CLIENT_URL=http://localhost:3002

# Redis (optional in dev)
REDIS_URL=redis://localhost:6379

# Stripe (optional in dev)
STRIPE_SECRET_KEY=sk_test_dev_placeholder
STRIPE_PUBLISHABLE_KEY=pk_test_dev_placeholder

# Cloudinary (optional in dev)
CLOUDINARY_CLOUD_NAME=dev_cloud
CLOUDINARY_API_KEY=dev_api_key
CLOUDINARY_API_SECRET=dev_api_secret

# AI Service
AI_SERVICE_URL=http://localhost:8000

# Email (optional in dev)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=dev_user
SMTP_PASS=dev_pass
EMAIL_FROM=noreply@pawfectmatch.dev
