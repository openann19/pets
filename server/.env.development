# Development Environment Configuration
# This file is loaded in development mode

# Server Configuration
NODE_ENV=development
PORT=5001

# MongoDB Configuration (Use IPv4 to avoid connection issues)
MONGODB_URI=mongodb://127.0.0.1:27017/pawfectmatch

# Client Configuration
CLIENT_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# JWT Configuration
JWT_SECRET=dev-secret-change-in-production-12345678901234567890
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production-098765432109876543210
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# Redis Configuration (Optional - for caching)
REDIS_URL=redis://127.0.0.1:6379

# Cloudinary Configuration (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# OpenWeather API (for weather features)
OPENWEATHER_API_KEY=your_openweather_api_key

# Google Maps API (for location features)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Stripe Configuration (for payments)
STRIPE_SECRET_KEY=sk_test_your_stripe_test_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# OpenAI Configuration (for AI features)
OPENAI_API_KEY=your_openai_api_key

# Sentry Configuration (for error tracking)
SENTRY_DSN=

# Email Configuration (Optional)
EMAIL_FROM=noreply@pawfectmatch.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Push Notification Configuration
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_EMAIL=mailto:support@pawfectmatch.com

# Admin Configuration
ADMIN_EMAIL=admin@pawfectmatch.com
ADMIN_INITIAL_PASSWORD=change_this_password

# Development-only settings
LOG_LEVEL=debug
ENABLE_SWAGGER=true
DISABLE_AUTH=false