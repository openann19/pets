{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build": "mkdir -p dist && cp -r src/* dist/ && cp package.json dist/ && cp .env dist/ 2>/dev/null || true && echo 'Server build complete - dist folder created'",
    "test": "jest --runInBand",
    "test:admin": "jest tests/integration/admin.test.js --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "prod": "NODE_ENV=production node server.js",
    "prod:check": "NODE_ENV=production node ../scripts/production-check.js",
    "indexes:create": "node ../scripts/create-indexes.js",
    "indexes:list": "node ../scripts/create-indexes.js list",
    "migrate": "node ../scripts/migrations/001-add-user-roles.js",
    "migrate:down": "node ../scripts/migrations/001-add-user-roles.js down",
    "admin:create": "node ../scripts/create-admin-user.js",
    "setup:prod": "npm run indexes:create && npm run migrate",
    "backup": "bash ../scripts/backup-mongodb.sh",
    "restore": "bash ../scripts/restore-mongodb.sh",
    "perf:test": "node ../scripts/performance-test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@sentry/node": "^10.16.0",
    "@sentry/profiling-node": "^10.16.0",
    "axios": "^1.12.2",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.7.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.18.2",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "node-cache": "^5.1.2",
    "nodemailer": "^7.0.6",
    "nodemon": "^3.1.10",
    "rate-limit": "^0.1.1",
    "redis": "^5.8.2",
    "socket.io": "^4.8.1",
    "stripe": "^18.5.0",
    "uuid": "^9.0.1",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/supertest": "^2.0.16",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.2.1",
    "node-fetch": "^3.3.2",
    "supertest": "^7.0.0"
  }
}
