# =============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# 
# IMPORTANT: 
# 1. Copy this file to .env.production
# 2. Replace ALL placeholder values with real production values
# 3. NEVER commit .env.production to version control
# 4. Use strong, randomly generated secrets (see generation commands below)
#
# =============================================================================

# -----------------------------------------------------------------------------
# SERVER CONFIGURATION
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=5001

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# Use MongoDB Atlas or your production MongoDB instance
# Format: mongodb+srv://username:password@cluster.mongodb.net/database
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/pawfectmatch?retryWrites=true&w=majority

# -----------------------------------------------------------------------------
# JWT SECRETS (CRITICAL - MUST CHANGE!)
# -----------------------------------------------------------------------------
# Generate strong secrets using:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#
# NEVER use default values in production!
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_STRING_FROM_CRYPTO_RANDOM_BYTES
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_HEX_STRING
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# -----------------------------------------------------------------------------
# FRONTEND/CLIENT
# -----------------------------------------------------------------------------
# Your production frontend URL (must use HTTPS)
CLIENT_URL=https://pawfectmatch.com

# Allowed origins for CORS (comma-separated, no spaces)
ALLOWED_ORIGINS=https://pawfectmatch.com,https://www.pawfectmatch.com

# -----------------------------------------------------------------------------
# CLOUDINARY (Media Storage)
# -----------------------------------------------------------------------------
# Get these from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# -----------------------------------------------------------------------------
# STRIPE (Payments)
# -----------------------------------------------------------------------------
# Use LIVE keys for production (start with sk_live_ and pk_live_)
STRIPE_SECRET_KEY=sk_live_YOUR_STRIPE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_STRIPE_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# -----------------------------------------------------------------------------
# EMAIL SERVICE
# -----------------------------------------------------------------------------
EMAIL_USER=noreply@pawfectmatch.com
EMAIL_PASS=your-email-app-password
EMAIL_FROM=PawfectMatch <noreply@pawfectmatch.com>

# -----------------------------------------------------------------------------
# AI SERVICE
# -----------------------------------------------------------------------------
AI_SERVICE_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# MONITORING & ERROR TRACKING (Optional)
# -----------------------------------------------------------------------------
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# REDIS_URL=redis://username:password@your-redis-host:6379
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# QUICK SETUP GUIDE
# -----------------------------------------------------------------------------
# 1. cp env.production.template .env.production
# 2. Generate secrets and update values
# 3. node scripts/create-indexes.js
# 4. node scripts/migrations/001-add-user-roles.js
# 5. node scripts/create-admin-user.js admin@example.com password

