# =============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================
# 
# IMPORTANT: 
# 1. Replace ALL placeholder values with real production values
# 2. NEVER commit this file to version control
# 3. Use strong, randomly generated secrets
#
# =============================================================================

# -----------------------------------------------------------------------------
# SERVER CONFIGURATION
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=5001

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# Use MongoDB Atlas or your production MongoDB instance
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/pawfectmatch?retryWrites=true&w=majority

# -----------------------------------------------------------------------------
# JWT SECRETS (CRITICAL - MUST CHANGE!)
# -----------------------------------------------------------------------------
# Generate strong secrets using:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=302807343c3e802f26a5dce2622054c9f41914b64d653a6982c2bf8439314b1f2ef7384fcdf4ba47d6e3decb38024d12207c9af8571a6f524c1e37459f9f4654
JWT_REFRESH_SECRET=90297a1bc5892658d39693608787884fcf9c13bdc1e9a138b2d59893c7906bc556956e5d49bf7d32f2e069a5eb8bdf03dd8b8a492b6213daa0feaf4ab91a98a1
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# -----------------------------------------------------------------------------
# FRONTEND/CLIENT
# -----------------------------------------------------------------------------
# Your production frontend URL (must use HTTPS)
CLIENT_URL=https://pawfectmatch.com

# Allowed origins for CORS (comma-separated, no spaces)
ALLOWED_ORIGINS=https://pawfectmatch.com,https://www.pawfectmatch.com

# -----------------------------------------------------------------------------
# CLOUDINARY (Media Storage)
# -----------------------------------------------------------------------------
# Get these from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# -----------------------------------------------------------------------------
# STRIPE (Payments)
# -----------------------------------------------------------------------------
# Use LIVE keys for production (start with sk_live_ and pk_live_)
STRIPE_SECRET_KEY=sk_live_YOUR_STRIPE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_STRIPE_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# -----------------------------------------------------------------------------
# EMAIL SERVICE
# -----------------------------------------------------------------------------
EMAIL_USER=noreply@pawfectmatch.com
EMAIL_PASS=your-email-app-password
EMAIL_FROM=PawfectMatch <noreply@pawfectmatch.com>

# -----------------------------------------------------------------------------
# AI SERVICE
# -----------------------------------------------------------------------------
AI_SERVICE_URL=https://ai.pawfectmatch.com
DEEPSEEK_API_KEY=sk-53af1f0560c54499aa5d6d39b02dd109

# -----------------------------------------------------------------------------
# MONITORING & ERROR TRACKING
# -----------------------------------------------------------------------------
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# REDIS (Optional, for caching)
# -----------------------------------------------------------------------------
# REDIS_URL=redis://username:password@your-redis-host:6379

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------
# Rate limiting configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
