/**
 * Jest Expect Adapters for PawfectMatch Web App
 * Provides compatibility layer and safe DOM assertions for Jest tests
 */

import { getTextContent, hasClass, isInDocument } from './test-utils';

// Type definitions for better TypeScript support
interface ExpectAdapter {
  (actual: unknown): ExpectAdapter;
  not: ExpectAdapter;
  toBe: (expected: unknown) => void;
  toEqual: (expected: unknown) => void;
  toStrictEqual: (expected: unknown) => void;
  toBeInTheDocument: () => void;
  toHaveClass: (className: string) => void;
  toHaveTextContent: (text: string) => void;
  toContain: (expected: string | unknown[]) => void;
  toThrow: (error?: string | RegExp | Error) => void;
  toHaveBeenCalled: () => void;
  toHaveBeenCalledWith: (...args: unknown[]) => void;
  toHaveBeenCalledTimes: (times: number) => void;
  toHaveProperty: (property: string, value?: unknown) => void;
  toBeGreaterThan: (expected: number) => void;
  toBeLessThan: (expected: number) => void;
  toBeGreaterThanOrEqual: (expected: number) => void;
  toBeLessThanOrEqual: (expected: number) => void;
  toBeCloseTo: (expected: number, precision?: number) => void;
  toMatchSnapshot: () => void;
  toMatchInlineSnapshot: (snapshot?: string) => void;
  toBeNull: () => void;
  toBeUndefined: () => void;
  toBeDefined: () => void;
  toBeTruthy: () => void;
  toBeFalsy: () => void;
  toBeInstanceOf: (constructor: new (...args: unknown[]) => unknown) => void;
  toContainEqual: (expected: unknown) => void;
  toHaveLength: (length: number) => void;
  toBeTypeOf: (type: string) => void;
}

// Helper function to create expect adapter
const createExpectAdapter = (actual: unknown, negated = false): ExpectAdapter => {
  const adapter: ExpectAdapter = {
    toBe: (expected: unknown) => {
      if (negated) {
        expect(actual).to.not.equal(expected);
      } else {
        expect(actual).to.equal(expected);
      }
    },

    toEqual: (expected: unknown) => {
      if (negated) {
        expect(actual).to.not.deep.equal(expected);
      } else {
        expect(actual).to.deep.equal(expected);
      }
    },

    toStrictEqual: (expected: unknown) => {
      if (negated) {
        expect(actual).to.not.deep.equal(expected);
      } else {
        expect(actual).to.deep.equal(expected);
      }
    },

    toBeInTheDocument: () => {
      if (negated) {
        expect(isInDocument(actual as Element)).to.be.false;
      } else {
        expect(isInDocument(actual as Element)).to.be.true;
      }
    },

    toHaveClass: (className: string) => {
      if (negated) {
        expect(hasClass(actual as Element, className)).to.be.false;
      } else {
        expect(hasClass(actual as Element, className)).to.be.true;
      }
    },

    toHaveTextContent: (text: string) => {
      const actualText = getTextContent(actual as Element);
      if (negated) {
        expect(actualText).to.not.include(text);
      } else {
        expect(actualText).to.include(text);
      }
    },

    toContain: (expected: string | unknown[]) => {
      if (negated) {
        expect(actual).to.not.include(expected);
      } else {
        expect(actual).to.include(expected);
      }
    },

    toThrow: (error?: string | RegExp | Error) => {
      if (typeof actual === 'function') {
        if (negated) {
          expect(() => actual()).to.not.throw(error);
        } else {
          expect(() => actual()).to.throw(error);
        }
      } else {
        throw new Error('toThrow can only be used with functions');
      }
    },

    toHaveBeenCalled: () => {
      if (negated) {
        expect(actual).to.not.have.been.called;
      } else {
        expect(actual).to.have.been.called;
      }
    },

    toHaveBeenCalledWith: (...args: unknown[]) => {
      if (negated) {
        expect(actual).to.not.have.been.calledWith(...args);
      } else {
        expect(actual).to.have.been.calledWith(...args);
      }
    },

    toHaveBeenCalledTimes: (times: number) => {
      if (negated) {
        expect(actual).to.not.have.callCount(times);
      } else {
        expect(actual).to.have.callCount(times);
      }
    },

    toHaveProperty: (property: string, value?: unknown) => {
      if (negated) {
        if (value !== undefined) {
          expect(actual).to.not.have.property(property, value);
        } else {
          expect(actual).to.not.have.property(property);
        }
      } else {
        if (value !== undefined) {
          expect(actual).to.have.property(property, value);
        } else {
          expect(actual).to.have.property(property);
        }
      }
    },

    toBeGreaterThan: (expected: number) => {
      if (negated) {
        expect(actual as number).to.not.be.greaterThan(expected);
      } else {
        expect(actual as number).to.be.greaterThan(expected);
      }
    },

    toBeLessThan: (expected: number) => {
      if (negated) {
        expect(actual as number).to.not.be.lessThan(expected);
      } else {
        expect(actual as number).to.be.lessThan(expected);
      }
    },

    toBeGreaterThanOrEqual: (expected: number) => {
      if (negated) {
        expect(actual as number).to.not.be.at.least(expected);
      } else {
        expect(actual as number).to.be.at.least(expected);
      }
    },

    toBeLessThanOrEqual: (expected: number) => {
      if (negated) {
        expect(actual as number).to.not.be.at.most(expected);
      } else {
        expect(actual as number).to.be.at.most(expected);
      }
    },

    toBeCloseTo: (expected: number, precision = 2) => {
      if (negated) {
        expect(actual as number).to.not.be.closeTo(expected, precision);
      } else {
        expect(actual as number).to.be.closeTo(expected, precision);
      }
    },

    toMatchSnapshot: () => {
      // Skip snapshot tests as per premium UX rules
      console.warn('Snapshot tests are disabled - use semantic assertions instead');
    },

    toMatchInlineSnapshot: (snapshot?: string) => {
      // Skip snapshot tests as per premium UX rules
      console.warn('Snapshot tests are disabled - use semantic assertions instead');
    },

    toBeNull: () => {
      if (negated) {
        expect(actual).to.not.be.null;
      } else {
        expect(actual).to.be.null;
      }
    },

    toBeUndefined: () => {
      if (negated) {
        expect(actual).to.not.be.undefined;
      } else {
        expect(actual).to.be.undefined;
      }
    },

    toBeDefined: () => {
      if (negated) {
        expect(actual).to.be.undefined;
      } else {
        expect(actual).to.not.be.undefined;
      }
    },

    toBeTruthy: () => {
      if (negated) {
        expect(actual).to.not.be.ok;
      } else {
        expect(actual).to.be.ok;
      }
    },

    toBeFalsy: () => {
      if (negated) {
        expect(actual).to.be.ok;
      } else {
        expect(actual).to.not.be.ok;
      }
    },

    toBeInstanceOf: (constructor: new (...args: unknown[]) => unknown) => {
      if (negated) {
        expect(actual).to.not.be.instanceOf(constructor);
      } else {
        expect(actual).to.be.instanceOf(constructor);
      }
    },

    toContainEqual: (expected: unknown) => {
      if (negated) {
        expect(actual).to.not.deep.include(expected);
      } else {
        expect(actual).to.deep.include(expected);
      }
    },

    toHaveLength: (length: number) => {
      if (negated) {
        expect(actual).to.not.have.lengthOf(length);
      } else {
        expect(actual).to.have.lengthOf(length);
      }
    },

    toBeTypeOf: (type: string) => {
      if (negated) {
        expect(actual).to.not.be.a(type);
      } else {
        expect(actual).to.be.a(type);
      }
    },
  } as ExpectAdapter;

  // Add not property
  adapter.not = createExpectAdapter(actual, !negated);

  return adapter;
};

// Main expect function
export const expectAdapter = (actual: unknown): ExpectAdapter => {
  return createExpectAdapter(actual, false);
};

// Export individual assertion functions for explicit usage
export const expectEqual = (actual: unknown, expected: unknown) => {
  expect(actual).to.equal(expected);
};

export const expectDeepEqual = (actual: unknown, expected: unknown) => {
  expect(actual).to.deep.equal(expected);
};

export const expectInDocument = (element: Element | null) => {
  expect(isInDocument(element)).to.be.true;
};

export const expectHasClass = (element: Element | null, className: string) => {
  expect(hasClass(element, className)).to.be.true;
};

export const expectThrows = (fn: () => unknown, error?: string | RegExp | Error) => {
  expect(fn).to.throw(error);
};

export const expectCalled = (fn: unknown) => {
  expect(fn).to.have.been.called;
};

export const expectCalledWith = (fn: unknown, ...args: unknown[]) => {
  expect(fn).to.have.been.calledWith(...args);
};

export const expectProperty = (obj: unknown, property: string, value?: unknown) => {
  if (value !== undefined) {
    expect(obj).to.have.property(property, value);
  } else {
    expect(obj).to.have.property(property);
  }
};

// Default export
export default expectAdapter;