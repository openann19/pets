// Use a mock MongoDB implementation for this example
// In a real application, you would use the actual MongoDB driver

interface Collection {
    findOne: (query: unknown) => Promise<any>;
    find: (query: unknown) => Promise<unknown[]>;
    insertOne: (doc: unknown) => Promise<{ insertedId: string }>;
    updateOne: (query: unknown, update: unknown) => Promise<{ modifiedCount: number }>;
    deleteOne: (query: unknown) => Promise<{ deletedCount: number }>;
}

interface MockClient {
    connect: () => Promise<void>;
    close: () => Promise<void>;
    db: () => MockDb;
}

interface MockDb {
    collection: (name: string) => Collection;
}

// For a real implementation, you would use a MongoDB connection string
// from environment variables

// MongoDB client instance
let client: MockClient | null = null;
let dbInstance: MockDb | null = null;

/**
 * Connect to MongoDB and return the database instance
 */
export async function connectToDB() {
    // If we already have a connection, return the existing database instance
    if (client && dbInstance) {
        return {
            client,
            db: dbInstance,
            // Add collections as properties for easy access
            users: dbInstance.collection('users'),
            pets: dbInstance.collection('pets'),
            matches: dbInstance.collection('matches'),
            messages: dbInstance.collection('messages'),
            accountActions: dbInstance.collection('accountActions'),
            dataExports: dbInstance.collection('dataExports'),
        };
    }

    try {
        // Create a mock MongoDB client for this example
        // In a real implementation, this would use the actual MongoDB driver
        client = {
            connect: async () => { console.log('Mock DB connected'); },
            close: async () => { console.log('Mock DB disconnected'); },
            db: () => {
                const mockDb = {
                    collection: (name: string) => ({
                        findOne: async (query: unknown) => {
                            console.log(`Mock findOne in ${name} collection with query:`, query);
                            // Return mock data based on collection and query
                            if (name === 'users' && query._id) {
                                return { _id: query._id, email: 'user@example.com', firstName: 'Test', lastName: 'User' };
                            }
                            if (name === 'dataExports' && query.exportId) {
                                return {
                                    exportId: query.exportId,
                                    userId: query.userId || 'user123',
                                    status: 'completed',
                                    format: 'json',
                                    expiresAt: new Date(Date.now() + 7 * 24 * 60 * 60 * 1000).toISOString()
                                };
                            }
                            return null;
                        },
                        find: async () => [],
                        insertOne: async (_doc: unknown) => ({ insertedId: 'mock-id-' + Date.now() }),
                        updateOne: async () => ({ modifiedCount: 1 }),
                        deleteOne: async () => ({ deletedCount: 1 })
                    })
                };
                return mockDb;
            }
        };

        // Connect to mock MongoDB
        await client.connect();
        console.log('Connected to MongoDB (mock)');

        // Get the database instance
        dbInstance = client.db();

        // Return the database instance and collections
        return {
            client,
            db: dbInstance,
            // Add collections as properties for easy access
            users: dbInstance.collection('users'),
            pets: dbInstance.collection('pets'),
            matches: dbInstance.collection('matches'),
            messages: dbInstance.collection('messages'),
            accountActions: dbInstance.collection('accountActions'),
            dataExports: dbInstance.collection('dataExports'),
        };
    } catch (error) {
        console.error('MongoDB connection error:', error);
        throw new Error('Failed to connect to database');
    }
}

/**
 * Close the MongoDB connection
 */
export async function closeDbConnection() {
    if (client) {
        await client.close();
        console.log('MongoDB connection closed');
        client = null;
        dbInstance = null;
    }
}

/**
 * Generate a unique ID
 */
export function generateId(prefix = '') {
    const timestamp = Date.now().toString(36);
    const random = Math.random().toString(36).substring(2, 10);
    return `${prefix}${timestamp}${random}`;
}