/**
 * Deep Link Hook
 * React hook for managing deep linking functionality
 */

import { useCallback, useEffect, useState } from 'react';
import type { DeepLinkRoute, ShareOptions } from '../services/DeepLinkService';
import DeepLinkService from '../services/DeepLinkService';

export interface DeepLinkState {
  currentRoute: DeepLinkRoute | null;
  isInitialized: boolean;
  isLoading: boolean;
}

export interface DeepLinkActions {
  handleUrl: (url: string) => Promise<boolean>;
  generateUrl: (
    route: string,
    params?: Record<string, string>,
    query?: Record<string, string>,
    fragment?: string,
  ) => string;
  shareLink: (options: ShareOptions) => Promise<void>;
  openInNewTab: (url: string) => void;
  copyToClipboard: (url: string) => Promise<void>;
  updateSocialMeta: (meta?: {
    title?: string;
    description?: string;
    image?: string;
    url?: string;
  }) => void;
  navigateToRoute: (route: string) => Promise<void>;
}

export const useDeepLink = (): DeepLinkState & DeepLinkActions => {
  const [state, setState] = useState<DeepLinkState>({
    currentRoute: null,
    isInitialized: false,
    isLoading: true,
  });

  // Initialize deep link service
  useEffect(() => {
    const initializeDeepLink = async () => {
      try {
        setState((prev) => ({ ...prev, isLoading: true }));

        await DeepLinkService.initialize();

        // Get initial route
        const currentRoute = DeepLinkService.getCurrentRoute();

        setState((prev) => ({
          ...prev,
          currentRoute,
          isInitialized: true,
          isLoading: false,
        }));
      } catch (error) {
        console.error('Failed to initialize deep link service:', error);
        setState((prev) => ({
          ...prev,
          isInitialized: false,
          isLoading: false,
        }));
      }
    };

    initializeDeepLink();
  }, []);

  // Setup event listeners
  useEffect(() => {
    if (!state.isInitialized) return;

    const handleRouteChanged = (event: CustomEvent) => {
      const route = event.detail as DeepLinkRoute;
      setState((prev) => ({ ...prev, currentRoute: route }));
    };

    window.addEventListener('routeChanged', handleRouteChanged as EventListener);

    return () => {
      window.removeEventListener('routeChanged', handleRouteChanged as EventListener);
    };
  }, [state.isInitialized]);

  // Handle URL
  const handleUrl = useCallback(async (url: string): Promise<boolean> => {
    try {
      return await DeepLinkService.handleUrl(url);
    } catch (error) {
      console.error('Failed to handle URL:', error);
      return false;
    }
  }, []);

  // Generate URL
  const generateUrl = useCallback(
    (
      route: string,
      params?: Record<string, string>,
      query?: Record<string, string>,
      fragment?: string,
    ): string => DeepLinkService.generateUrl(route, params, query, fragment),
    [],
  );

  // Share link
  const shareLink = useCallback(async (options: ShareOptions): Promise<void> => {
    try {
      await DeepLinkService.shareLink(options);
    } catch (error) {
      console.error('Failed to share link:', error);
    }
  }, []);

  // Open in new tab
  const openInNewTab = useCallback((url: string): void => {
    DeepLinkService.openInNewTab(url);
  }, []);

  // Copy to clipboard
  const copyToClipboard = useCallback(async (url: string): Promise<void> => {
    try {
      await DeepLinkService.copyToClipboard(url);
    } catch (error) {
      console.error('Failed to copy to clipboard:', error);
    }
  }, []);

  // Update social meta
  const updateSocialMeta = useCallback(
    (meta?: { title?: string; description?: string; image?: string; url?: string }): void => {
      DeepLinkService.updateSocialMetaTags(meta);
    },
    [],
  );

  // Navigate to route
  const navigateToRoute = useCallback(
    async (route: string): Promise<void> => {
      try {
        await handleUrl(route);
      } catch (error) {
        console.error('Failed to navigate to route:', error);
      }
    },
    [handleUrl],
  );

  return {
    ...state,
    handleUrl,
    generateUrl,
    shareLink,
    openInNewTab,
    copyToClipboard,
    updateSocialMeta,
    navigateToRoute,
  };
};
