{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    },
    "allowJs": true,
    "incremental": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "skipLibCheck": true,
    "types": ["node"],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strictNullChecks": true, "noImplicitAny": false
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "cypress",
    "**/*.test.ts",
    "**/*.test.tsx",
    "src/__tests__",
    "src/components/**/__tests__",
    "public/app-components/**",
    "app/test-paws/**/*",
    "src/tests/**/*",
    "src/app/**/*",
    "src/hooks/premium-hooks.tsx",
    "src/hooks/api-hooks.tsx",
    "src/hooks/useAuth.ts",
    "src/hooks/useAuthForms.ts",
    "src/hooks/useChat.ts",
    "src/hooks/useEnhancedSocket.ts",
    "src/hooks/useOptimizedAuth.ts",
    "src/hooks/useSwipe.ts",
    "src/components/Chat/**/*",
    "src/components/Layout/DashboardBackdrop.tsx",
    "src/components/Map/AIMapFeatures.tsx",
    "src/components/AI/**/*",
    "src/components/VideoCall/**/*",
    "src/components/Premium/SubscriptionManager.tsx",
    "src/components/providers/AuthProvider.tsx",
    "src/services/EnhancedWeatherService.ts",
    "src/services/GeofencingService.ts",
    "src/services/NotificationService.ts",
    "src/services/weatherProviders.ts",
    "src/services/WeatherService.ts",
    "src/providers/NotificationProvider.tsx",
    "src/providers/WeatherProvider.tsx",
    "src/index.tsx",
    "app/**/*"
  ]
}
