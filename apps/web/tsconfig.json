{
  "extends": "../../tsconfig.base.json", // <-- Inherits all strict rules
  "compilerOptions": {
    // --- Overrides & additions for this specific package ---
    "lib": ["ES2023", "DOM", "DOM.Iterable"], // Add DOM types for the browser
    "allowJs": true,
    "noEmit": true, // Next.js handles emitting files
    "module": "ESNext", // Next.js requirement
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "jsx": "preserve", // Next.js requirement

    // --- Path Mapping for this app ---
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@pawfectmatch/ui": ["../../packages/ui/src/index.ts"],
      "@pawfectmatch/ui/*": ["../../packages/ui/src/*"],
      "@pawfectmatch/core": ["../../packages/core/dist/index.d.ts"],
      "@pawfectmatch/core/*": ["../../packages/core/dist/*"]
    },
    
    // --- Next.js Plugin ---
    "plugins": [{ "name": "next" }],
    "types": ["node", "jest"]
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "coverage",
    "**/*.test.ts" // Exclude test files from the main build
  ]
}
