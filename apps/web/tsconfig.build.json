{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "jsx": "preserve",
    "lib": ["DOM", "ES2020"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "app/**/*",
    "src/**/*"
  ],
  "exclude": [
    "**/*.test.*",
    "**/__tests__/**",
    "tests/**",
    "coverage/**",
    "cypress/**",
    "playwright-report/**",
    "**/*.stories.*"
  ]
}
