#!/usr/bin/env node

let logger;
try {
  logger = require('@pawfectmatch/core').logger;
} catch {
  logger = {
    info: console.log,
    warn: console.warn,
    error: console.error,
  };
}
const { execSync } = require('child_process');

logger.info('🚀 Running PawfectMatch Calling Features Test Suite\n');

const testCategories = [
  {
    name: 'WebRTC Service Tests',
    pattern: 'src/services/__tests__/WebRTCService.test.ts',
    description: 'Core WebRTC functionality, call management, signaling',
  },
  {
    name: 'Call Manager Tests',
    pattern: 'src/components/calling/__tests__/CallManager.test.tsx',
    description: 'Call state management, modal handling, event coordination',
  },
  {
    name: 'Socket Hook Tests',
    pattern: 'src/hooks/__tests__/useSocket.test.ts',
    description: 'Socket connection, authentication, event handling',
  },
  {
    name: 'Incoming Call Screen Tests',
    pattern: 'src/screens/calling/__tests__/IncomingCallScreen.test.tsx',
    description: 'Incoming call UI, animations, user interactions',
  },
  {
    name: 'Active Call Screen Tests',
    pattern: 'src/screens/calling/__tests__/ActiveCallScreen.test.tsx',
    description: 'Active call UI, controls, video/voice modes',
  },
  {
    name: 'Chat Screen Calling Tests',
    pattern: 'src/screens/__tests__/ChatScreen.calling.test.tsx',
    description: 'Call buttons in chat, integration with call manager',
  },
  {
    name: 'Matches Screen Calling Tests',
    pattern: 'src/screens/__tests__/MatchesScreen.calling.test.tsx',
    description: 'Call buttons in matches list, match-specific calling',
  },
];

const results = {
  passed: 0,
  failed: 0,
  total: 0,
  coverage: {},
  details: [],
};

function parseJestSummary(output) {
  const m = output.match(/Tests:\s+(?:(\d+)\s+failed,\s+)?(?:(\d+)\s+passed,\s+)?(\d+)\s+total/i);
  if (!m) return { failed: 0, passed: 0, total: 0 };
  const failed = m[1] ? parseInt(m[1], 10) : 0;
  const passed = m[2] ? parseInt(m[2], 10) : 0;
  const total = m[3] ? parseInt(m[3], 10) : failed + passed;
  return { failed, passed, total };
}

function runTestCategory(category) {
  logger.info(`\n📋 Running ${category.name}...`);
  logger.info(`   ${category.description}`);
  try {
    const command = `npx jest ${category.pattern} --verbose --coverage --collectCoverageFrom="src/**/*.{ts,tsx}" --coverageReporters=text-summary`;
    const output = execSync(command, {
      cwd: process.cwd(),
      encoding: 'utf8',
      stdio: 'pipe',
    });

    const { failed, passed, total } = parseJestSummary(output);
    results.failed += failed;
    results.passed += passed;
    results.total += total || passed + failed;
    results.details.push({
      category: category.name,
      passed,
      failed,
      status: failed === 0 ? 'PASS' : 'FAIL',
      output,
    });

    if (failed === 0) {
      logger.info(`   ✅ ${passed} tests passed`);
    } else {
      logger.warn(`   ❌ ${failed} tests failed, ${passed} tests passed`);
    }

    const cov = output.match(/All files\s+\|\s+([\d.]+)\s+\|\s+([\d.]+)\s+\|\s+([\d.]+)\s+\|\s+([\d.]+)/);
    if (cov) {
      results.coverage[category.name] = {
        statements: parseFloat(cov[1]),
        branches: parseFloat(cov[2]),
        functions: parseFloat(cov[3]),
        lines: parseFloat(cov[4]),
      };
    }
  } catch (error) {
    const out = (error && (error.stdout || error.stderr) || '') + '';
    const { failed, passed, total } = parseJestSummary(out);
    results.failed += failed || 1;
    results.passed += passed || 0;
    results.total += total || (failed || 1) + (passed || 0);
    logger.error(`   🔥 Error running tests for ${category.name}`);
    logger.error(out || error.message);
    results.details.push({
      category: category.name,
      passed: passed || 0,
      failed: failed || 1,
      status: 'ERROR',
      output: out || error.message,
    });
  }
}

function printSummary() {
  logger.info('\n\n========================================');
  logger.info('       Calling Features Test Summary      ');
  logger.info('========================================\n');

  results.details.forEach((detail) => {
    const status = detail.status === 'PASS' ? '✅' : detail.status === 'FAIL' ? '❌' : '🔥';
    logger.info(`${status} ${detail.category}: ${detail.passed} passed, ${detail.failed} failed`);
    if (detail.status !== 'PASS') {
      logger.info('---');
      const lines = (detail.output || '').split('\n').filter((line) => line.includes('●') || line.includes('  at '));
      if (lines.length > 0) logger.info(lines.join('\n'));
      logger.info('---');
    }
  });

  logger.info('\n----------------------------------------\n');
  logger.info('📊 Overall Results:');
  logger.info(`  - Total Tests: ${results.total}`);
  logger.info(`  - Passed: ${results.passed}`);
  logger.info(`  - Failed: ${results.failed}`);

  if (Object.keys(results.coverage).length) {
    logger.info('\n📈 Coverage Summary:');
    Object.keys(results.coverage).forEach((category) => {
      const cov = results.coverage[category];
      logger.info(`  - ${category}:`);
      logger.info(`    - Statements: ${cov.statements}%`);
      logger.info(`    - Branches: ${cov.branches}%`);
      logger.info(`    - Functions: ${cov.functions}%`);
      logger.info(`    - Lines: ${cov.lines}%`);
    });
  }

  logger.info('\n========================================\n');
  if (results.failed > 0) {
    logger.error('🔥 Some tests failed. Please review the logs above.');
    process.exit(1);
  } else {
    logger.info('✅ All calling feature tests passed successfully!');
    process.exit(0);
  }
}

// Run all test categories and print summary
testCategories.forEach(runTestCategory);
printSummary();
